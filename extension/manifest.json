{
  "manifest_version": 3,
  "name": "TabDeck",
  "version": "0.4.0",
  "description": "Lets a local AI agent drive your real Chrome over MCP: one task-named tab group per session, page reading, clicking and typing.",
  "minimum_chrome_version": "116",
  "permissions": [
    "tabs",
    "tabGroups",
    "nativeMessaging",
    "storage",
    "alarms",
    "debugger"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "key": ""
}
